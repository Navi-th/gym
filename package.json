{
  "name": "gym-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fsd": "node scripts/check-fsd-layers.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:watch": "vitest",
    "verify": "npm run lint:fsd && tsc --noEmit && npm test --silent && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gym-app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gym-app-db --remote",
    "db:seed:local": "wrangler d1 execute gym-app-db --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute gym-app-db --remote --file=./scripts/seed.sql",
    "db:seed1000:local": "wrangler d1 execute gym-app-db --local --file=./scripts/seed-1000.sql",
    "db:seed1000:remote": "wrangler d1 execute gym-app-db --remote --file=./scripts/seed-1000.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed:local",
    "db:studio": "drizzle-kit studio",
    "build:cf": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && wrangler dev",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && wrangler deploy"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.3.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "wrangler": "^3.88.0"
  }
}

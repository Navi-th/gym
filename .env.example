# Copy this file to `.env` and fill in the values.
# `.env` is gitignored; `.env.example` is committed.

# Wrangler needs an explicit account id when more than one Cloudflare account
# is authenticated on the machine. Find yours by running:
#
#   npx wrangler whoami
#
CLOUDFLARE_ACCOUNT_ID=

# --- WhatsApp (added in module 8/9) -------------------------------------
# NEVER commit these. Set them with `wrangler secret put <NAME>` for production.
# For local development they can live in `.env` / `.dev.vars`.
#
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
# CRON_SECRET=
